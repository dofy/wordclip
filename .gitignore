*.dSYM.zip
*.dSYM
# .xcodeproj 由 xcodegen 从 project.yml 生成，不入库
# 换电脑后运行 `xcodegen generate` 重新生成
*.xcodeproj/

# Swift Package Manager
.build/
.swiftpm/
# xcodebuild 自定义 derivedDataPath 产物
.build-ios/
.build-xcode/
.build-xcode-ios/
.build-release/
# Package.resolved 入库，确保跨机器构建使用相同依赖版本

# Provisioning / secrets
*.mobileprovision
*.p12
*.cer
secrets.xcconfig
.env

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# 词库构建产物（原始大文件不入库，构建时生成）
data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal
data/*.db
data/*.zip
data/*.log
data/raw/

# 本机 AI 助手配置（settings.local.json 含本机路径与权限白名单）
.claude/
