    "help.faq.hotkey.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that Accessibility is granted in System Settings, and that “Enable Selection Capture” is on under Settings → Selection Capture. (OCR capture is independent and unaffected by this switch.)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查系统设置是否授权「辅助功能」，以及设置 → 选中收词 里「启用选中收词」是否打开。（OCR 收词独立，不受此开关影响。）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查「系統設定」是否授權「輔助使用」，以及 設定 → 選取收錄 裡的「啟用選取收錄」是否打開。（OCR 收錄是獨立的，不受這個開關影響。）"
          }
        }
      },
      "extractionState": "manual"
    },
    "help.faq.hotkey.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture hotkey does nothing?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收词快捷键没反应？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收錄快速鍵沒反應？"
          }
        }
      },
      "extractionState": "manual"
    },
    "help.faq.import.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the dictionary is toggled on under Settings → Dictionaries."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认在 设置 → 词典 里该词典的开关是打开的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認 設定 → 字典 裡該字典的開關是打開的。"
          }
        }
      },
      "extractionState": "manual"
    },
    "help.faq.import.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported dictionary not working?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入的词典没生效？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入的字典沒生效？"
          }
        }
      },
      "extractionState": "manual"
    },
    "help.faq.nodef.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dictionary may not have been ready when it was saved. It auto-fills in the word list, or press ⌘R to repair."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能收录时词典未就绪。进入生词本会自动补全，也可选中该词按 ⌘R 手动修复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能收錄當時字典還沒就緒。進入單字本會自動補上，也可以選取該字按 ⌘R 手動修復。"
          }
        }
      },
      "extractionState": "manual"
    },
    "help.faq.nodef.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A word shows “No definition”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个词「暂无释义」？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "某個單字顯示「尚無釋義」？"
          }
        }
      },
      "extractionState": "manual"
    },
    "help.open": {
      "comment": "Menu / settings entry to open help",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help"
          }
        },
