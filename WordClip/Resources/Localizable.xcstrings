    "settings.speech.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All voices read English; regions indicate accents. Novelty voices are excluded. Classic voices use older synthesizers and may sound robotic. The original rate is 0.90×."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有声音均朗读英语，地区表示口音。已排除趣味效果声音；经典声音使用较早的合成器，听感可能偏机械。原有语速为 0.90×。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有聲音均朗讀英語，地區表示口音。已排除趣味效果聲音；經典聲音使用較早的合成器，聽感可能偏機械。原有語速為 0.90×。"
          }
        }
      }
    },
