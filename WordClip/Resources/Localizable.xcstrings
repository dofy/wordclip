        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出 JSON 备份（免费，含学习进度）；在新设备导入恢复（Pro），按单词智能合并、不覆盖进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出 JSON 備份（免費，含學習進度）；在新裝置匯入還原（Pro），依單字智慧合併、不覆蓋進度。"
          }
        }
      },
      "extractionState": "manual"
    },
    "help.data.backup.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup Import / Export"
          }
        },
        "zh-Hans": {
