{
  "sourceLanguage": "en",
  "strings": {
    "accessibility.banner.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WordClip needs Accessibility permission to read selected text. Grant it in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WordClip 需要辅助功能权限才能读取选中的文字，请在系统设置中授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "WordClip 需要輔助使用權限才能讀取選取的文字，請在「系統設定」中授權。"
          }
        }
      }
    },
