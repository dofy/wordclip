    "help.packs.group.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported words stay in their own group, separate from the words you save yourself. Use the group picker at the top of Review, or in the word list toolbar, to study a single pack — or choose “All” to mix them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入的词与手动收录的词按分组隔离。复习页顶部或生词本工具栏的分组选择器,可只学某个包,或选「全部」混学。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入的單字與手動收錄的單字按分組隔離。複習頁上方或單字本工具列的分組選擇器，可以只學某一包，或選「全部」混著學。"
          }
        }
      }
    },
    "help.packs.group.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group isolation and filtering"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分组隔离与过滤"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分組隔離與篩選"
          }
        }
      }
    },
    "help.packs.remove.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter the word list to one pack, tap “Remove This Pack” and confirm: that deletes all of the pack’s words along with their review progress. You can import it again at any time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在生词本工具栏把分组过滤到某个懒人包,点「移除此懒人包」并确认,即可删掉该包的全部单词与复习进度,之后仍可重新导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在單字本工具列把分組篩選到某個單字包，點「移除此單字包」並確認，就會刪掉這一包的所有單字與複習進度，之後仍可重新匯入。"
          }
        }
      }
    },
    "help.packs.remove.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing a word pack"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除懒人包"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除單字包"
          }
        }
      }
    },
    "help.packs.what.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Graded packs (Beginner / Gaokao / CET-4 & CET-6 / Postgraduate / TOEFL / IELTS / GRE) and topic packs (Daily Life / Travel & Leisure / Tech English / Business). All free, all offline — import one and start studying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分级包(初学者/高考/CET-4/6/考研/托福/雅思/GRE)与场景包(日常生活/旅游娱乐/技术英语/商务职场),全部免费离线,一键导入即可学习。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分級包（初學者／學測指考／CET-4、6／研究所／托福／雅思／GRE）與情境包（日常生活／旅遊休閒／技術英語／商務職場），全部免費離線，匯入就能開始學。"
          }
        }
      }
    },
    "help.packs.what.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in word packs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预置懒人包"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內建單字包"
          }
        }
      }
    },
    "help.review.sm2.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know it → the interval keeps growing (1d→6d→…); Don’t → reset to tomorrow. A word you keep marking unknown stays “New”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认识 → 间隔越拉越长（1天→6天→…），越熟越久才提醒；不认识 → 重置回明天重新巩固。一直标记「不认识」的词会停留在「新词」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "認識 → 間隔越拉越長（1 天→6 天→…），越熟越久才提醒；不認識 → 重設回明天重新鞏固。一直標記「不認識」的單字會留在「新字」。"
          }
        }
      },
      "extractionState": "manual"
    },
    "help.review.sm2.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SM-2 Spaced Repetition"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SM-2 间隔重复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SM-2 間隔重複"
          }
        }
      },
      "extractionState": "manual"
    },
    "help.review.states.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New (green, not yet marked known) · Due (orange, time to review) · Fresh (no badge, next review still far off)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新词（绿，还没认识过）· 待复习（橙，到了该复习的时间）· 记忆新鲜（无徽标，离下次复习还早）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新字（綠，還沒認識過）· 待複習（橘，到了該複習的時間）· 記憶新鮮（無標記，離下次複習還早）。"
          }
        }
      },
      "extractionState": "manual"
    },
