      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to Import a Dictionary"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如何导入词典"
          }
        },
        "zh-Hant": {
