    },
    "help.data.pro.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time purchase, lifetime unlock: OCR capture, iCloud sync, import/export. Collecting and basic lookup are always free."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性买断、终身解锁：OCR 收词、iCloud 同步、词库导入/导出。收集与基础查词永久免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次買斷、終身解鎖：OCR 收錄、iCloud 同步、詞庫匯入與匯出。收錄與基本查詢永久免費。"
          }
        }
      },
      "extractionState": "manual"
    },
    "help.data.pro.title": {
      "localizations": {
