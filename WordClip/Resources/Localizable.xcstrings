    "help.collect.menubar.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See today's overview, toggle selection capture, open the main window, or open Settings. The icon dims when capture is off. Close the window with ⌘W and the Dock icon goes with it — WordClip keeps running here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看今日概览、快速启用/停用选中收词、打开主窗口、打开设置。图标常亮/变暗指示收词是否启用。按 ⌘W 关闭窗口后 Dock 图标一起消失，WordClip 继续在这里运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看今日總覽、快速啟用或停用選取收錄、打開主視窗、打開設定。圖像亮或暗代表收錄功能是否啟用。按 ⌘W 關閉視窗後 Dock 圖示一起消失，WordClip 繼續在這裡執行。"
          }
        }
      },
      "extractionState": "manual"
    },
