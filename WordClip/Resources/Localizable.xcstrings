        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches in your list show on top; dictionary words you haven’t saved show below — tap to preview and save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上方显示生词本匹配词，下方显示词典中未收录的词，点击可预览释义并一键收录。"
