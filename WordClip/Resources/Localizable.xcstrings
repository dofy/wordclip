    "settings.speech.downloadHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add voices, open Accessibility settings, then Read & Speak (Spoken Content on older systems). Download enhanced or premium English voices there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需添加声音，请打开辅助功能中的「朗读与语音」（旧版系统为「朗读内容」），下载增强或优质英语声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如需加入聲音，請打開輔助使用中的「朗讀與語音」（舊版系統為「朗讀內容」），下載增強或優質英語聲音。"
          }
        }
      }
