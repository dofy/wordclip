    "settings.capture.ocr.hint": {
      "comment": "Settings footer: OCR capture, clarifies independence",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "框选屏幕区域识别其中的英文单词（Pro），适用于图片 / PDF / 不可选文本。不受上面「选中收词」开关影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a screen region to recognize English words in it (Pro) — works with images, PDFs, and non-selectable text. Independent of the Selection Capture switch above."
          }
        }
      }
    },
