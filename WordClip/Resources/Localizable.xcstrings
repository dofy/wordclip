      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove This Pack"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此懒人包"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此單字包"
          }
        }
      }
    },
    "wordlist.removePack.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This deletes the pack’s %lld word and its review progress. You can import it again at any time."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This deletes the pack’s %lld words and their review progress. You can import it again at any time."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除该懒人包的 %lld 个单词及其复习进度，可随时重新导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除這一包的 %lld 個單字及其複習進度，之後可以隨時重新匯入。"
          }
        }
      }
    },
