    "help.concepts.wordlist.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Word List"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生词本"
          }
        }
      }
    },
    "help.concepts.wordlist.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The words you’ve saved to study, with familiarity and review progress."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你收录、要学习的单词，带熟悉度与复习进度。"
          }
        }
      }
    },
    "help.concepts.dictionary.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictionary"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词典"
          }
        }
      }
    },
    "help.concepts.dictionary.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reference lexicon for lookups — 50k built-in ECDICT words, importable for more."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于查询的参考词库，内置 ECDICT 5 万词，可导入更多。"
          }
        }
      }
    },
    "help.collect.selection.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select to Capture · ⌥⌘C"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中收词 · ⌥⌘C"
          }
        }
      }
    },
    "help.collect.selection.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a word in any app and press the hotkey — a HUD confirms, the clipboard is untouched. Grant Accessibility on first use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任意 App 中选中英文单词按快捷键，弹 HUD 提示、不改剪贴板。首次需在系统设置授权「辅助功能」。"
          }
        }
      }
    },
    "help.collect.ocr.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR Capture · ⌥⌘O (Pro)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR 收词 · ⌥⌘O（Pro）"
          }
        }
      }
    },
    "help.collect.ocr.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to select any screen region and recognize its words — works on images, PDFs, non-selectable text. Grant Screen Recording on first use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "框选屏幕任意区域识别单词，适用于图片 / PDF / 不可选文本。首次需授权「屏幕录制」。"
          }
        }
      }
    },
    "help.collect.url.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "URL Scheme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "URL Scheme"
          }
        }
      }
    },
    "help.collect.url.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "wordclip://collect?word=<word> — capture from Shortcuts or scripts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "wordclip://collect?word=<单词>，可从快捷指令、脚本调用收词。"
          }
        }
      }
    },
    "help.collect.menubar.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu Bar Icon"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态栏图标"
          }
        }
      }
    },
    "help.collect.menubar.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See today's overview, toggle selection capture, or open the main window. The icon dims when capture is off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看今日概览、快速启用/停用选中收词、打开主窗口。图标常亮/变暗指示收词是否启用。"
          }
        }
      }
    },
    "help.add.manual.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Manually (iOS)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动添加（iOS）"
          }
        }
      }
    },
    "help.add.manual.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “+” in the word list to type or paste from the clipboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生词本右上角「+」，手动输入或从剪贴板粘贴。"
          }
        }
      }
    },
    "help.add.search.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search & Save · ⌘F"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索并收录 · ⌘F"
          }
        }
      }
    },
    "help.add.search.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches in your list show on top; dictionary words you haven’t saved show below — tap to preview and save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上方显示生词本匹配词，下方显示词典中未收录的词，点击可预览释义并一键收录。"
          }
        }
      }
    },
    "help.review.states.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three States"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三种状态"
          }
        }
      }
    },
    "help.review.states.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New (green, not yet marked known) · Due (orange, time to review) · Fresh (no badge, next review still far off)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新词（绿，还没认识过）· 待复习（橙，到了该复习的时间）· 记忆新鲜（无徽标，离下次复习还早）。"
          }
        }
      }
    },
    "help.review.sm2.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SM-2 Spaced Repetition"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SM-2 间隔重复"
          }
        }
      }
    },
    "help.review.sm2.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know it → the interval keeps growing (1d→6d→…); Don’t → reset to tomorrow. A word you keep marking unknown stays “New”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认识 → 间隔越拉越长（1天→6天→…），越熟越久才提醒；不认识 → 重置回明天重新巩固。一直标记「不认识」的词会停留在「新词」。"
          }
        }
      }
    },
    "help.data.backup.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup Import / Export"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份导入 / 导出"
          }
        }
      }
    },
    "help.data.backup.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export a JSON backup (free, includes progress); import to restore on a new device (Pro), merged per word without overwriting progress."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出 JSON 备份（免费，含学习进度）；在新设备导入恢复（Pro），按单词智能合并、不覆盖进度。"
          }
        }
      }
    },
    "help.data.pro.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WordClip Pro"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WordClip Pro"
          }
        }
      }
    },
    "help.data.pro.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time purchase, lifetime unlock: OCR capture, iCloud sync, import/export. Collecting and basic lookup are always free."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性买断、终身解锁：OCR 收词、iCloud 同步、词库导入/导出。收集与基础查词永久免费。"
          }
        }
      }
    },
    "help.faq.hotkey.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture hotkey does nothing?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收词快捷键没反应？"
          }
        }
      }
    },
    "help.faq.hotkey.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that Accessibility is granted in System Settings, and that “Enable Selection Capture” is on under Settings → Selection Capture. (OCR capture is independent and unaffected by this switch.)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查系统设置是否授权「辅助功能」，以及设置 → 选中收词 里「启用选中收词」是否打开。（OCR 收词独立，不受此开关影响。）"
          }
        }
      }
    },
    "help.faq.nodef.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A word shows “No definition”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个词「暂无释义」？"
          }
        }
      }
    },
    "help.faq.nodef.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dictionary may not have been ready when it was saved. It auto-fills in the word list, or press ⌘R to repair."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能收录时词典未就绪。进入生词本会自动补全，也可选中该词按 ⌘R 手动修复。"
          }
        }
      }
    },
    "help.faq.import.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported dictionary not working?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入的词典没生效？"
          }
        }
      }
    },
    "help.faq.import.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the dictionary is toggled on under Settings → Dictionaries."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认在 设置 → 词典 里该词典的开关是打开的。"
          }
        }
      }
    },
    "settings.section.study": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Study"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学习"
          }
        }
      }
    },
    "settings.study.roundsize": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words per round"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每轮学习词数"
          }
        }
      }
    },
    "settings.study.roundsize.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many words each round covers — a mix of due reviews and new words, ending automatically. Uses the actual count when you have fewer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一轮固定学习的单词数，兼顾到期复习词与新词，学完自动结束。词量不足时学实际数量。"
          }
        }
      }
    },
    "dictguide.title": {
      "comment": "Dict import guide: page title",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to Import a Dictionary"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如何导入词典"
          }
        }
      }
    },
    "dictguide.section.what": {
      "comment": "Dict import guide: section 'what'",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What This Is"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是什么"
          }
        }
      }
    },
    "dictguide.what.title": {
      "comment": "Dict import guide: what title",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra sources for lookups"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩充查词的释义来源"
          }
        }
      }
    },
    "dictguide.what.body": {
      "comment": "Dict import guide: what body",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported dictionaries only add extra definitions when you look up a word (e.g. specialized terms, other languages). They do not add words to your word list — use Word Packs for that."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入的词典只在你查词时提供额外释义(如专业术语、其他语言),不会往生词本加词。想批量添加学习词条,请用「懒人包」。"
          }
        }
      }
    },
    "dictguide.section.when": {
      "comment": "Dict import guide: section 'when'",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When You Need It"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么时候需要"
          }
        }
      }
    },
    "dictguide.when.title": {
      "comment": "Dict import guide: when title",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most people don't need this"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多数人无需导入"
          }
        }
      }
    },
    "dictguide.when.body": {
      "comment": "Dict import guide: when body",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The built-in ECDICT (50k words) already covers everyday English. Useful when you want a specialized dictionary (medical / legal / tech), definitions into another language, or you have your own word list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置 ECDICT 5 万词已覆盖日常英语。适合这些情况:查专业领域词库(医学 / 法律 / 计算机)、需要英→其他语言释义、已有自制词表。"
          }
        }
      }
    },
    "dictguide.section.format": {
      "comment": "Dict import guide: section 'format'",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported Formats"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持的格式"
          }
        }
      }
    },
    "dictguide.csv.title": {
      "comment": "Dict import guide: CSV title",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV table"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV 表格"
          }
        }
      }
    },
    "dictguide.csv.body": {
      "comment": "Dict import guide: CSV body",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three columns per row: word, definition, phonetic (phonetic optional). Comma- or tab-separated; header row optional; wrap a definition in double quotes if it contains a comma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行三列:单词、释义、音标(音标可省)。逗号或制表符分隔;首行表头可选;释义含逗号时用双引号包裹。"
          }
        }
      }
    },
    "dictguide.sqlite.title": {
      "comment": "Dict import guide: SQLite title",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SQLite database"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SQLite 词库"
          }
        }
      }
    },
    "dictguide.sqlite.body": {
      "comment": "Dict import guide: SQLite body",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Must contain an `entries` table with `word` and `definition` columns (ECDICT structure); adopted directly on import."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需含 entries 表,且有 word、definition 列(即 ECDICT 结构),导入时直接采用。"
          }
        }
      }
    },
    "dictguide.section.prepare": {
      "comment": "Dict import guide: section 'prepare'",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to Prepare One"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "怎么自己准备"
          }
        }
      }
    },
    "dictguide.prepare.excel.title": {
      "comment": "Dict import guide: prepare excel title",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make a CSV in a spreadsheet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用表格软件做 CSV"
          }
        }
      }
    },
    "dictguide.prepare.excel.body": {
      "comment": "Dict import guide: prepare excel body",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill three columns in Excel / Numbers / Google Sheets, then Save As / Export as CSV (UTF-8)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Excel / Numbers / Google 表格里填三列,「另存为 / 导出」时选 CSV(UTF-8)即可。"
          }
        }
      }
    },
    "dictguide.prepare.sqlite.title": {
      "comment": "Dict import guide: prepare sqlite title",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced: build a SQLite file"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进阶:自制 SQLite"
          }
        }
      }
    },
    "dictguide.prepare.sqlite.body": {
      "comment": "Dict import guide: prepare sqlite body",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build one from open dictionary data. For example, this app's built-in dictionary comes from ECDICT (MIT-licensed)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用开源词典数据自制。例如本 App 内置词库即来自 ECDICT(MIT 开源)。"
          }
        }
      }
    },
