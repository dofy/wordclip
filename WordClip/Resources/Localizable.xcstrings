    "settings.dict.hint": {
      "comment": "Settings: dictionary import hint",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported dictionaries add extra definitions when looking up words (they don't add words to your list). Multiple dictionaries stack in order; built-in takes priority."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入词典可在查词时提供额外释义（不会往生词本加词）。多本按顺序叠加，内置优先。"
          }
        }
      }
    },
    "dict.builtin.name": {
