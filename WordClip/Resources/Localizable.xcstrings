    "dictguide.sqlite.body": {
      "comment": "Dict import guide: SQLite body",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Must contain an `entries` table with `word` and `definition` columns (ECDICT structure); adopted directly on import."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需含 entries 表,且有 word、definition 列(即 ECDICT 结构),导入时直接采用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須含有 entries 資料表，且有 word、definition 欄位（也就是 ECDICT 結構），匯入時直接採用。"
          }
        }
      },
      "extractionState": "manual"
    },
